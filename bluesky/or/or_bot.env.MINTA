# SAMPLE — this file is a SAMPLE, not a live key file.
#
# The owner creates it AS ADMINISTRATOR, with Notepad, under this name:
#     C:\BskyGuard\titok\or_bot.env
#
# This is the GUARD'S OWN, NEW Telegram bot — NOT the existing bot. It is new
# because the existing bot's database can be written by the `agent-user` user,
# so it cannot be the anchor of the approval.
#
# OR_BOT_TOKEN : the token received from BotFather (of the form …:…).
# OWNER_USER_ID: your Telegram user id.
# OWNER_CHAT_ID: the id of the PRIVATE chat with you.
#
# You can find out the two ids like this (AFTER entering the token):
#     python or.py --ki-vagyok
# — send a message to the new bot, and it prints both to the CONSOLE.
# (It writes nothing to a file.)

OR_BOT_TOKEN=your-new-bot-token-here
OWNER_USER_ID=0
OWNER_CHAT_ID=0
