# SAMPLE — copy it as `bsky_kulcs.env` and fill it in BY HAND.
# The owner creates the real file; the agent never writes it or reads it aloud.
#
# The password is NOT the main password of the Bluesky account, but an APP PASSWORD:
#   Bluesky → Settings → Privacy and security → App passwords → Add App Password
# An app password cannot delete the account and cannot change the main password,
# and it can be revoked at any time in the same place (Revoke).

BSKY_HANDLE=example-bot.bsky.social
BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
